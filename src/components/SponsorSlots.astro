---
// The sponsor grid: eight tiles, each a sponsor's logo and name (a plain
// `rel="sponsored"` link — no tracking pixels, no scripts) or an open slot
// that books itself on /sponsor/. `wide` is the home-page band (4 × 2);
// `compact` fits the generator-page sidebar.
//
// The build draws every slot open; the Worker fills the taken ones from
// sponsors.json on R2 as the page is served (src/lib/sponsor-slots.js), using
// the `data-sponsor-*` hooks below. `data-twin="skip"` keeps the grid out of
// the markdown twins agents read.
import { DEFAULT_SPONSORS, firstOpen, tileHtml } from '../lib/sponsor-slots.js';

interface Props {
  variant?: 'wide' | 'compact';
  class?: string;
}
const { variant = 'wide', class: extra = '' } = Astro.props;
const compact = variant === 'compact';
const { slots } = DEFAULT_SPONSORS;
const open = firstOpen(slots);
---

<aside aria-label="Sponsors" data-twin="skip" data-sponsor-grid={variant} class={extra}>
  <div class:list={['text-ink-muted flex items-center justify-between', compact ? 'mb-2 text-[11px]' : 'mb-3 text-xs']}>
    <span class="font-mono tracking-widest uppercase">Sponsored</span>
    <a href={`/sponsor/${open ? `?slot=${open}` : ''}`} data-sponsor-advertise class="hover:text-ink no-underline">
      Advertise here →
    </a>
  </div>
  <ul class="m-0 grid list-none grid-cols-4 gap-2 p-0">
    {slots.map((s, i) => <li class="min-w-0" data-sponsor-slot={i + 1} set:html={tileHtml(s.sponsor, i + 1, variant)} />)}
  </ul>
</aside>
