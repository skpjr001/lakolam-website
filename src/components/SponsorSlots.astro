---
// The sponsor grid: eight tiles, each a sponsor's logo and name (a plain
// `rel="sponsored"` link — no tracking pixels, no scripts) or an open slot
// that books itself on /sponsor/. `wide` is the home-page band (4 × 2);
// `compact` fits the generator-page sidebar.
//
// `data-twin="skip"` keeps the grid out of the markdown twins agents read.
import { SPONSOR_SLOTS, sponsorHref } from '../lib/sponsors';

interface Props {
  variant?: 'wide' | 'compact';
  class?: string;
}
const { variant = 'wide', class: extra = '' } = Astro.props;
const compact = variant === 'compact';
const firstOpen = SPONSOR_SLOTS.findIndex((s) => s === null) + 1;
const tile = compact
  ? 'h-[68px] gap-1 rounded-lg px-1'
  : 'h-[84px] gap-1.5 rounded-xl px-2 sm:h-[92px]';
const mark = compact ? 'size-7 rounded-md' : 'size-8 rounded-lg sm:size-9';
const text = compact ? 'text-[11px]' : 'text-xs';
---

<aside aria-label="Sponsors" data-twin="skip" class={extra}>
  <div class:list={['text-ink-muted flex items-center justify-between', compact ? 'mb-2 text-[11px]' : 'mb-3 text-xs']}>
    <span class="font-mono tracking-widest uppercase">Sponsored</span>
    <a href={`/sponsor/${firstOpen ? `?slot=${firstOpen}` : ''}`} class="hover:text-ink no-underline">
      Advertise here →
    </a>
  </div>
  <ul class="m-0 grid list-none grid-cols-4 gap-2 p-0">
    {
      SPONSOR_SLOTS.map((s, i) => (
        <li class="min-w-0">
          {s ? (
            <a
              href={sponsorHref(s.url)}
              target="_blank"
              rel="sponsored noopener"
              title={s.name}
              class:list={[
                'border-line bg-surface-raised hover:border-accent-dim flex flex-col items-center justify-center border text-center no-underline transition-colors',
                tile,
              ]}
            >
              {s.logo ? (
                <img src={s.logo} alt="" loading="lazy" width="36" height="36" class:list={['object-contain', mark]} />
              ) : (
                <span class:list={['bg-ink text-surface flex items-center justify-center font-semibold', mark]}>
                  {s.name.slice(0, 1)}
                </span>
              )}
              <span class:list={['text-ink max-w-full truncate font-medium', text]}>{s.name}</span>
            </a>
          ) : (
            <a
              href={`/sponsor/?slot=${i + 1}`}
              rel="nofollow"
              aria-label={`Sponsor slot ${i + 1} is open — put your logo here`}
              class:list={[
                'border-line text-ink-muted hover:border-accent hover:text-accent flex flex-col items-center justify-center border border-dashed text-center no-underline transition-colors',
                tile,
              ]}
            >
              <span class:list={['flex items-center justify-center border border-dashed border-current', mark]} aria-hidden="true">
                +
              </span>
              <span class:list={['max-w-full truncate', text]}>
                {compact ? 'Your logo' : <>Your logo<span class="hidden sm:inline"> here</span></>}
              </span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</aside>
