---
// One generator in a grid: its real rendered thumbnail, name and blurb.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  blurb: string;
  /** Eager-load above-the-fold cards (home hero strip). */
  eager?: boolean;
}
const { id, title, blurb, eager = false } = Astro.props;

const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/generators/*.png'
);
const thumb = thumbs[`../assets/generators/${id}.png`];
---

<a
  href={`/generators/${id}/`}
  class="group border-line bg-surface-raised hover:border-accent-dim block overflow-hidden rounded-xl border no-underline transition-colors"
>
  {
    thumb && (
      <Image
        src={thumb()}
        alt={`${title} — a page generated by Lakolam`}
        width={400}
        height={400}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="aspect-square w-full bg-white object-cover"
      />
    )
  }
  <div class="p-4">
    <h3 class="text-ink group-hover:text-accent m-0 text-sm font-semibold transition-colors">
      {title}
    </h3>
    <p class="text-ink-muted mt-1 line-clamp-2 text-xs leading-relaxed">{blurb}</p>
  </div>
</a>
