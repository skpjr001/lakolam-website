---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const nav = [
  { href: '/generators/', label: 'Generators' },
  { href: '/studio/', label: 'Studio' },
  { href: '/about/', label: 'About' },
  { href: '/brand/', label: 'Brand' },
];
const path = Astro.url.pathname;
---

<header
  class="border-line bg-surface/85 sticky top-0 z-40 border-b backdrop-blur"
>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6"
  >
    <a href="/" class="text-ink no-underline" aria-label="Lakolam home">
      <Logo class="text-base" />
    </a>

    <nav class="order-3 flex w-full gap-5 text-sm sm:order-none sm:w-auto" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
            class:list={[
              'no-underline transition-colors',
              path.startsWith(item.href)
                ? 'text-accent font-medium'
                : 'text-ink-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="border-line text-ink-muted hover:text-ink cursor-pointer rounded-lg border p-1.5"
        aria-label="Switch between light and dark theme"
      >
        <svg viewBox="0 0 24 24" class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
      </button>
      <a
        href={SITE.studio}
        target="_blank" rel="noopener noreferrer"
        class="bg-accent hover:bg-accent-strong text-surface rounded-lg px-3 py-1.5 text-sm font-semibold no-underline transition-colors"
      >
        Open the studio
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('lakolam-theme', dark ? 'dark' : 'light');
  });
</script>
