---
// The mark + wordmark lockup. The mark is a two-ring labyrinth: one entrance,
// one doorway, the goal at the centre — "every page has one way in".
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-baseline gap-2', className]}>
  <svg
    viewBox="0 0 32 32"
    class="size-[1.35em] self-center text-accent"
    aria-hidden="true"
  >
    <g
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      fill="none"
    >
      <path d="M 20.28 4.25 A 12.5 12.5 0 1 1 11.72 4.25"></path>
      <path d="M 12.54 22.65 A 7.5 7.5 0 1 1 19.46 22.65"></path>
    </g>
    <circle cx="16" cy="16" r="2.3" fill="currentColor"></circle>
  </svg>
  <span class="text-[1.05em] font-semibold tracking-tight">Lakolam</span>
</span>
