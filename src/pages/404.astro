---
import Base from '../layouts/Base.astro';

const title = 'Page not found — Lakolam';
const description = 'This path leads nowhere. Every maze here has exactly one solution — this page is not on it.';
---

<Base title={title} description={description}>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-accent font-mono text-sm">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Dead end</h1>
    <p class="text-ink-muted mt-3 max-w-md leading-relaxed">
      Every maze we generate has exactly one path to the goal — and this page
      isn't on it. Back up and try a different corridor.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="bg-accent hover:bg-accent-strong text-surface rounded-lg px-5 py-2.5 text-sm font-semibold no-underline transition-colors">
        Back to the entrance
      </a>
      <a href="/generators/" class="border-line hover:border-accent-dim text-ink rounded-lg border px-5 py-2.5 text-sm font-medium no-underline transition-colors">
        Browse generators
      </a>
    </div>
  </div>
</Base>
