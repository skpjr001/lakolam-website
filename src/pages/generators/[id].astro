---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import GeneratorCard from '../../components/GeneratorCard.astro';
import { CATEGORY_LABELS, LANE_SLUGS, SITE, studioUrl } from '../../lib/site';
import * as ld from '../../lib/jsonld';
import {
  generatorDescription,
  generatorFacts,
  generatorHeading,
  generatorKeywords,
  generatorTitle,
} from '../../lib/seo';

export async function getStaticPaths() {
  const generators = await getCollection('generators');
  return generators.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, blurb, category, version } = entry.data;

const all = (await getCollection('generators')).sort((a, b) => a.id.localeCompare(b.id));
// The next four in the same lane, wrapping round — so every generator page is
// linked from its neighbours, not just the first four of each lane.
const lane = all.filter((g) => g.data.category === category);
const at = lane.findIndex((g) => g.id === entry.id);
const related = [...lane.slice(at + 1), ...lane.slice(0, at)].slice(0, 4);

const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/generators/*.png'
);
const thumb = thumbs[`../../assets/generators/${entry.id}.png`];

const pageTitle = generatorTitle(category, title);
const description = generatorDescription(category, blurb);
const heading = generatorHeading(category, title);
const keywords = generatorKeywords(category, title);
const facts = generatorFacts(category);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const studioLink = studioUrl(entry.id);
const jsonLd = [
  ld.breadcrumbs(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Generators', path: '/generators/' },
    { name: title, path: `/generators/${entry.id}/` },
  ]),
  ld.generatorWork({
    id: entry.id,
    title,
    heading,
    blurb,
    category,
    lane: CATEGORY_LABELS[category],
    version,
    studioLink,
    keywords,
  }),
];
---

<Base
  title={pageTitle}
  description={description}
  ogImage={`/og/generators/${entry.id}.png`}
  ogImageAlt={`${title} — generated by Lakolam at seed ${SITE.artSeed}`}
  jsonLd={jsonLd}
  keywords={keywords}
  mainEntity={ld.generatorId(entry.id)}
  relatedLinks={related.map((g) => ld.generatorUrl(g.id))}
>
  <article class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav class="text-ink-muted text-sm" aria-label="Breadcrumb">
      <a href="/generators/" class="hover:text-ink no-underline">Generators</a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink">{title}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_360px]">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight first-letter:uppercase">{heading}</h1>
          <a
            href={`/${LANE_SLUGS[category]}/`}
            class="border-line text-ink-muted hover:border-accent-dim hover:text-ink rounded-full border px-3 py-0.5 text-xs no-underline transition-colors"
          >
            {CATEGORY_LABELS[category]}
          </a>
          <span class="text-ink-muted font-mono text-xs">v{version}</span>
        </div>
        <p class="text-ink-muted mt-3 max-w-2xl text-lg leading-relaxed">{blurb}.</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={studioLink}
            target="_blank" rel="noopener noreferrer"
            class="bg-accent hover:bg-accent-strong text-surface rounded-lg px-4 py-2 text-sm font-semibold no-underline transition-colors"
          >
            Open {title} in the studio
          </a>
        </div>

        <div class="prose mt-8">
          <Content />
        </div>
      </div>

      <aside>
        <div class="sticky top-24">
        {
          thumb && (
            <figure class="border-line m-0 overflow-hidden rounded-xl border">
              <a href={studioLink} target="_blank" rel="noopener noreferrer" title={`Open this page in the studio — seed ${SITE.artSeed}`}>
              <Image
                src={thumb()}
                alt={`${title}: a page generated by Lakolam at seed ${SITE.artSeed}`}
                width={720}
                height={720}
                loading="eager"
                class="w-full bg-white"
              />
              </a>
              <figcaption class="bg-surface-raised text-ink-muted px-4 py-2.5 font-mono text-xs">
                lako preview -g {entry.id} --seed {SITE.artSeed}
              </figcaption>
            </figure>
          )
        }
        <section class="border-line mt-6 rounded-xl border px-4 py-3 text-sm" aria-label="At a glance">
          <h2 class="text-ink m-0 text-sm font-semibold">At a glance</h2>
          <dl class="m-0">
          {
            facts.map((fact) => (
              <div class="border-line mt-2 border-t pt-2">
                <dt class="text-ink-muted text-xs tracking-wide uppercase">{fact.label}</dt>
                <dd class="text-ink m-0 mt-0.5">{fact.value}</dd>
              </div>
            ))
          }
          </dl>
        </section>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-xl font-bold tracking-tight">
              More {CATEGORY_LABELS[category]?.toLowerCase()}s
            </h2>
            <a href={`/${LANE_SLUGS[category]}/`} class="text-sm">
              All {lane.length} {CATEGORY_LABELS[category]?.toLowerCase()}s →
            </a>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {related.map((g) => (
              <GeneratorCard id={g.id} title={g.data.title} blurb={g.data.blurb} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
