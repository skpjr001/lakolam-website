---
// Sponsor a slot: what the eight tiles are, what they cost, and a booking
// form. The form writes an email (there is no payment backend yet): the
// request arrives in the inbox, an invoice goes back, and the slot goes live
// once it is paid — by filling it in src/lib/sponsors.ts and deploying.
import Base from '../layouts/Base.astro';
import SponsorSlots from '../components/SponsorSlots.astro';
import { SITE } from '../lib/site';
import { DEFAULT_SPONSORS, priceSummary, slotOption } from '../lib/sponsor-slots.js';

const SPONSOR_EMAIL = SITE.contact.email;
const { slots } = DEFAULT_SPONSORS;
// Every slot is listed; the Worker drops the taken ones (and their prices
// come from sponsors.json on R2), so this page is always current.
const all = slots.map((_, i) => i + 1);
const field =
  'border-line bg-surface focus:border-accent w-full rounded-lg border px-3 py-2 text-sm text-ink outline-none';
const label = 'text-ink mb-1 block text-sm font-medium';
---

<Base
  title="Sponsor a Slot | Lakolam"
  description={`Put your logo on the Lakolam home page and beside all ${SITE.stats.generators} generator pages: eight sponsor slots, billed monthly, no tracking.`}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="text-accent font-mono text-xs tracking-widest uppercase">Sponsor a slot</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Your logo, in front of people who make pages</h1>
    <p class="text-ink-muted mt-4 max-w-2xl text-lg leading-relaxed">
      Lakolam is read by teachers, puzzle-book publishers, parents and makers
      looking for printable puzzles, worksheets, colouring pages and paper.
      Eight sponsor slots sit on the home page and beside every one of the
      {' '}{SITE.stats.generators} generator pages — your logo, your name and a
      link, styled like the rest of the site.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_420px]">
      <div>
        <h2 class="text-xl font-bold tracking-tight">How it works</h2>
        <ul class="text-ink-muted mt-4 space-y-3 text-sm leading-relaxed">
          <li><strong class="text-ink">Where:</strong> the home page, and the sidebar of every generator page.</li>
          <li><strong class="text-ink">What:</strong> your logo, your brand name and a link to your site (marked <code class="font-mono text-xs">rel="sponsored"</code>, tagged <code class="font-mono text-xs">?ref=lakolam</code> so you can count the visits).</li>
          <li><strong class="text-ink">No tracking:</strong> no pixels, no pop-ups, no scripts — a link and a picture.</li>
          <li>
            <strong class="text-ink">Price:</strong>{' '}
            <strong class="text-ink" data-sponsor-prices>{priceSummary(slots)}</strong>{' '}
            — each slot's price is shown in the form. Billed monthly, cancel any time.
          </li>
          <li><strong class="text-ink">Going live:</strong> send the form, we reply with an invoice, and your slot goes live within one working day of payment.</li>
          <li><strong class="text-ink">What we accept:</strong> products and services for learners, teachers, makers and publishers. We may decline anything unsuitable for a family audience.</li>
        </ul>

        <h2 class="mt-10 text-xl font-bold tracking-tight">The slots</h2>
        <p class="text-ink-muted mt-2 text-sm">Exactly as they appear on the site. Pick an open one.</p>
        <SponsorSlots class="mt-5 max-w-xl" />
      </div>

      <div class="border-line bg-surface-raised rounded-xl border p-6">
        <h2 class="text-xl font-bold tracking-tight">Book a slot</h2>
            <p class="text-ink-muted mt-4 text-sm leading-relaxed" data-sponsor-full hidden>
              Every slot is booked right now. Email{' '}
              <a href={`mailto:${SPONSOR_EMAIL}?subject=${encodeURIComponent('Sponsor slot waiting list')}`}>{SPONSOR_EMAIL}</a>{' '}
              to join the waiting list.
            </p>
            <form id="sponsor-form" class="mt-5 space-y-4" novalidate data-email={SPONSOR_EMAIL}>
              <div>
                <label for="sp-slot" class={label}>Slot</label>
                <select id="sp-slot" name="slot" class={field}>
                  {all.map((n) => (
                    <option value={n} data-price={slots[n - 1].price} data-sponsor-option={n}>
                      {slotOption(slots, n)}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="sp-brand" class={label}>Brand name</label>
                <input id="sp-brand" name="brand" required maxlength="40" class={field} placeholder="Shown under your logo" />
              </div>
              <div>
                <label for="sp-link" class={label}>Website</label>
                <input id="sp-link" name="link" type="url" required maxlength="300" class={field} placeholder="https://" />
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="sp-name" class={label}>Your name</label>
                  <input id="sp-name" name="name" required maxlength="80" class={field} />
                </div>
                <div>
                  <label for="sp-email" class={label}>Email</label>
                  <input id="sp-email" name="email" type="email" required maxlength="200" class={field} />
                </div>
              </div>
              <div>
                <label for="sp-note" class={label}>Note <span class="text-ink-muted font-normal">(optional)</span></label>
                <textarea id="sp-note" name="note" rows="3" maxlength="1000" class={field}></textarea>
              </div>
              <p id="sp-error" class="m-0 text-sm text-red-600 dark:text-red-400" role="alert" hidden></p>
              <button type="submit" class="bg-accent hover:bg-accent-strong text-surface w-full rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors">
                Email the booking
              </button>
              <p class="text-ink-muted m-0 text-xs leading-relaxed">
                This opens your email app with the details filled in — attach
                your logo (square PNG or SVG) and send. Or write to{' '}
                <a href={`mailto:${SPONSOR_EMAIL}`}>{SPONSOR_EMAIL}</a> directly.
              </p>
            </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('sponsor-form') as HTMLFormElement | null;
    if (form) {
      const slot = form.querySelector<HTMLSelectElement>('#sp-slot')!;
      const wanted = new URLSearchParams(location.search).get('slot');
      if (wanted && [...slot.options].some((o) => o.value === wanted)) slot.value = wanted;
      const error = form.querySelector<HTMLElement>('#sp-error')!;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = (n: string) => String(new FormData(form).get(n) ?? '').trim();
        const problems: string[] = [];
        if (!v('brand')) problems.push('a brand name');
        if (!/^https?:\/\/\S+\.\S+/.test(v('link'))) problems.push('your website (starting https://)');
        if (!v('name')) problems.push('your name');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) problems.push('a valid email');
        if (problems.length) {
          error.textContent = `Please add ${problems.join(', ')}.`;
          error.hidden = false;
          return;
        }
        error.hidden = true;
        const price = slot.selectedOptions[0]?.dataset.price;
        const body = [
          `Slot: ${v('slot')}`,
          `Plan: $${price}/month`,
          `Brand: ${v('brand')}`,
          `Website: ${v('link')}`,
          `Name: ${v('name')}`,
          `Email: ${v('email')}`,
          v('note') ? `\n${v('note')}` : '',
          '\n(Logo attached: square PNG or SVG.)',
        ].join('\n');
        const subject = `Sponsor slot ${v('slot')} — ${v('brand')}`;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    }
  </script>
</Base>
