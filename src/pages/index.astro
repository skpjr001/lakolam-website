---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
import MazeScene from '../components/MazeScene.astro';
import CtaScene from '../components/CtaScene.astro';
import GeneratorCard from '../components/GeneratorCard.astro';
import { SITE, CATEGORY_LABELS, CATEGORY_BLURBS } from '../lib/site';
import * as ld from '../lib/jsonld';

const generators = (await getCollection('generators')).sort((a, b) =>
  a.id.localeCompare(b.id)
);
const featured = ['mandala', 'maze', 'sudoku', 'kolam', 'crossword', 'celtic', 'nonogram', 'tiling']
  .map((id) => generators.find((g) => g.id === id))
  .filter((g) => g !== undefined);
const lanes = (['design', 'maze', 'puzzle', 'word'] as const).map((cat) => ({
  cat,
  label: CATEGORY_LABELS[cat],
  blurb: CATEGORY_BLURBS[cat],
  count: generators.filter((g) => g.data.category === cat).length,
  sample: generators.filter((g) => g.data.category === cat)[0]?.id,
}));

const faqs = [
  {
    q: 'How is this different from AI image generators?',
    a: 'There is no model and no sampling. Every page is closed-form mathematics and constraint solving: motifs are parametric curves, puzzles are built against solvers, and the output is a vector scene — reproducible byte-for-byte from its seed. Nothing is approximated, so nothing can hallucinate.',
  },
  {
    q: 'What does "deterministic" mean here?',
    a: 'The same generator, spec and seed produce byte-identical output, forever. Every page is reproducible: record the seed and you can regenerate the exact same mandala, maze or sudoku years later, at any size or format.',
  },
  {
    q: 'Are the puzzles guaranteed to be solvable?',
    a: 'Yes — every puzzle generator ships with a solver that proves the puzzle has exactly one solution and scores its difficulty by the techniques required. A generator without a solver does not merge.',
  },
  {
    q: 'What formats can I export?',
    a: 'SVG is the resolution-independent master; PNG and JPEG at any DPI, and print-ready PDF including KDP trim sizes with bleed. Fixed social-media canvases (Instagram, Pinterest, story) are built in.',
  },
  {
    q: 'Is Lakolam free?',
    a: 'Yes. The engine and both studios are open source under MIT or Apache-2.0, and the browser studio runs entirely client-side — nothing is uploaded, no account is needed.',
  },
  {
    q: 'Does the studio need a server?',
    a: 'No. The whole engine compiles to WebAssembly and runs in your browser. Pages are generated on your machine; the site itself is static files.',
  },
  {
    q: 'Can I sell what I generate?',
    a: 'Yes. The engine is MIT OR Apache-2.0 and the pages you generate are yours — puzzle books, colouring books, classroom sets, social posts. Wordlists and quote corpora ship inside the crates and are drawn from public-domain sources.',
  },
  {
    q: 'How are difficulty ratings decided?',
    a: 'By the solver, not by feel. Each puzzle is solved with a ladder of human reasoning techniques, and its rating is the hardest technique actually required. The metadata reports both the requested and the measured difficulty, plus the rating basis.',
  },
];

const jsonLd = [
  ld.softwareApplication(),
  ld.gpuiStudio(),
  ld.sourceCode(),
  ld.faqPage(faqs),
];
---

<Base
  title="Lakolam — deterministic generative designs, mazes and puzzles"
  description={SITE.description}
  ogImage="/og/default.png"
  jsonLd={jsonLd}
>
  <!-- ── hero ── -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-14 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:pt-20">
    <div>
      <p class="text-accent font-mono text-xs tracking-widest uppercase">
        55 generators · 1,365 tests · one seed
      </p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        Infinite pages.<br />Zero surprises.
      </h1>
      <p class="text-ink-muted mt-5 max-w-xl text-lg leading-relaxed">
        Lakolam is an open-source engine that generates mandalas, kolams,
        mazes and logic puzzles as print-ready pages. Every output is
        reproducible from a seed. Every puzzle is <em>proven</em> to have
        exactly one solution.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={SITE.studio}
          rel="noopener"
          class="bg-accent hover:bg-accent-strong text-surface rounded-lg px-5 py-2.5 font-semibold no-underline transition-colors"
        >
          Open the studio — it's free
        </a>
        <a
          href="/generators/"
          class="border-line hover:border-accent-dim text-ink rounded-lg border px-5 py-2.5 font-medium no-underline transition-colors"
        >
          Browse all 55 generators
        </a>
      </div>
      <p class="text-ink-muted mt-6 font-mono text-xs">
        $ lako preview -g mandala --seed {SITE.artSeed} -o page.svg
      </p>
    </div>
    <Hero3D />
  </section>

  <!-- ── the three promises ── -->
  <section class="border-line bg-surface-raised border-y">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 md:grid-cols-3">
      {
        [
          {
            title: 'Deterministic, forever',
            body: 'Generator + spec + seed → byte-identical output, guaranteed by 1,365 tests. A page you made today can be regenerated pixel-for-pixel in ten years.',
          },
          {
            title: 'Proven, not sampled',
            body: 'Every puzzle ships with a solver that certifies a unique solution and rates difficulty by the reasoning techniques it actually requires — no "medium" guesswork.',
          },
          {
            title: 'Print-ready by design',
            body: 'SVG masters, 300-dpi PDFs with KDP bleed, social canvases. Colouring pages are gated on region size and stroke width, so nothing ships that can’t be coloured.',
          },
        ].map((p) => (
          <div>
            <h2 class="text-base font-semibold">{p.title}</h2>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── lanes ── -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight">Four lanes, one engine</h2>
    <p class="text-ink-muted mt-2 max-w-2xl">
      Every generator emits the same display list and renders through the same
      backends — so a maze, a mandala and a crossword all export identically.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        lanes.map((lane) => (
          <a
            href={`/generators/#${lane.cat}`}
            class="border-line bg-surface-raised hover:border-accent-dim rounded-xl border p-5 no-underline transition-colors"
          >
            <div class="text-accent font-mono text-2xl font-bold">{lane.count}</div>
            <h3 class="text-ink mt-1 font-semibold">{lane.label}</h3>
            <p class="text-ink-muted mt-2 text-sm leading-relaxed">{lane.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ── gallery strip ── -->
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-tight">Straight from the engine</h2>
      <a href="/generators/" class="text-accent text-sm font-medium no-underline">
        All generators →
      </a>
    </div>
    <p class="text-ink-muted mt-2 max-w-2xl">
      Nothing here is a mock-up: each preview below was rendered by
      <code class="font-mono text-xs">lako preview --seed {SITE.artSeed}</code>.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        featured.map((g) => (
          <GeneratorCard
            id={g.id}
            title={g.data.title}
            blurb={g.data.blurb}
          />
        ))
      }
    </div>
  </section>

  <!-- ── the studio ── -->
  <section class="border-line bg-surface-raised border-y">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold tracking-tight">The whole engine, in your browser</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="border-line bg-surface rounded-xl border p-6">
          <h3 class="font-semibold">Lakolam Studio</h3>
          <p class="text-ink-muted mt-2 text-sm leading-relaxed">
            The engine compiled to WebAssembly with schema-driven controls for
            every generator. Tweak a spec, step a seed, export SVG, PNG or PDF —
            all client-side, nothing uploaded, no account.
          </p>
          <a href={SITE.studio} rel="noopener" class="text-accent mt-4 inline-block text-sm font-semibold no-underline">
            Launch the studio →
          </a>
        </div>
        <div class="border-line bg-surface rounded-xl border p-6">
          <h3 class="font-semibold">GPUI Studio <span class="text-ink-muted text-xs font-normal">(experimental)</span></h3>
          <p class="text-ink-muted mt-2 text-sm leading-relaxed">
            The same engine with a fully-Rust, GPU-rendered interface — Zed's
            GPUI framework compiled to WebAssembly. One module holds the
            generators, the rasteriser, the UI and the fonts.
          </p>
          <a href={SITE.studioGpui} rel="noopener" class="text-accent mt-4 inline-block text-sm font-semibold no-underline">
            Try the GPUI studio →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CLI ── -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold tracking-tight">Or a thousand pages from the command line</h2>
      <p class="text-ink-muted mt-3 leading-relaxed">
        The <code class="font-mono text-sm">lako</code> CLI generates books:
        batches with answer keys, parameter sweeps as contact sheets, and a
        validator that fails the build if a single page fails its checks.
      </p>
      <a
        href={SITE.github}
        rel="noopener"
        class="text-accent mt-4 inline-block text-sm font-semibold no-underline"
      >
        Get it on GitHub →
      </a>
    </div>
    <pre
      class="border-line bg-surface-sunken overflow-x-auto rounded-xl border p-5 font-mono text-xs leading-relaxed"><code>$ lako generate -g nonogram --count 20 -o ./book
$ lako sweep -g flowfield --axis octaves=1,3,5 --seeds 4 -o ./sweep
$ lako validate -g wordfit --count 12   <span class="text-ink-muted"># exit 1 on any Fail</span>
$ lako preview -g maze --profile kdp_letter_bleed -o maze.pdf</code></pre>
  </section>

  <!-- ── the proof, animated: a seeded maze solving itself ── -->
  <section class="border-line bg-surface-raised border-y">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1fr_minmax(0,420px)]"
    >
      <div>
        <p class="text-accent font-mono text-xs tracking-widest uppercase">
          zero surprises, demonstrated
        </p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight">
          Watch a maze solve itself
        </h2>
        <p class="text-ink-muted mt-3 max-w-xl leading-relaxed">
          Every loop carves a fresh maze from the next seed and traces its one
          solution — the same promise every generator makes. A perfect maze has
          exactly one path between any two cells; the engine's solvers prove
          properties like this for every puzzle it ships.
        </p>
        <a
          href="/generators/maze/"
          class="text-accent mt-5 inline-block text-sm font-semibold no-underline"
        >
          About the maze generator →
        </a>
      </div>
      <MazeScene />
    </div>
  </section>

  <!-- ── FAQ: sticky intro beside one exclusive accordion ── -->
  <section id="faq" class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,320px)_1fr]">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="text-accent font-mono text-xs tracking-widest uppercase">FAQ</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">Questions, answered</h2>
      <p class="text-ink-muted mt-3 text-sm leading-relaxed">
        Every claim below is checkable — in the metadata a generation reports,
        or in the source itself.
      </p>
      <a
        href={`${SITE.github}/issues`}
        rel="noopener"
        class="text-accent mt-4 inline-block text-sm font-semibold no-underline"
      >
        Something else? Open an issue →
      </a>
    </div>
    <div class="border-line divide-line divide-y overflow-hidden rounded-xl border">
      {
        faqs.map((faq, i) => (
          <details class="group bg-surface-raised" name="faq" open={i === 0}>
            <summary class="hover:text-accent flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold transition-colors [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg
                viewBox="0 0 24 24"
                class="text-ink-muted size-4 shrink-0 transition-transform duration-200 group-open:rotate-90"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </summary>
            <p class="text-ink-muted -mt-1 max-w-2xl px-5 pb-5 text-sm leading-relaxed">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ── contact: bidflow's CTA recipe — layered accent glows, a big
       clamped headline, oversized actions, a glowing-dot note — improvised
       for an open-source engine: the studio is the demo, the repo is the
       contact channel, and a harmonograph draws itself behind it all. ── -->
  <section id="contact" class="cta-band border-line relative overflow-hidden border-t">
    <CtaScene />
    <div class="relative z-10 mx-auto max-w-[720px] px-4 py-[110px] text-center sm:px-6 lg:py-[130px]">
      <p class="text-accent font-mono text-xs font-bold tracking-[0.2em] uppercase">Get started</p>
      <h2 class="mt-4 text-[clamp(1.9rem,3.6vw,2.9rem)] leading-tight font-bold tracking-[-0.025em] text-balance">
        Your first thousand pages are one&nbsp;seed&nbsp;away.
      </h2>
      <p class="text-ink-muted mx-auto mt-4 max-w-xl text-[1.08rem] leading-relaxed">
        Generate in the browser right now, or install the CLI and build whole
        books — pages, answer keys and validation in one command.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          href={SITE.studio}
          rel="noopener"
          class="bg-accent hover:bg-accent-strong text-surface rounded-xl px-9 py-4 text-base font-semibold no-underline shadow-lg transition-colors"
        >
          Open the studio
        </a>
        <a
          href={SITE.github}
          rel="noopener"
          class="border-line bg-surface/70 hover:border-accent hover:text-accent text-ink rounded-xl border px-9 py-4 text-base font-medium no-underline backdrop-blur transition-colors"
        >
          View on GitHub
        </a>
      </div>
      <p class="text-ink-muted mt-7 text-sm">
        <span class="cta-dot" aria-hidden="true"></span>
        Questions, or a generator you wish existed?
        <a href={`${SITE.github}/issues`} rel="noopener" class="text-accent no-underline hover:underline">
          Open an issue
        </a>
        · seed <span class="font-mono text-xs">{SITE.artSeed}</span> draws behind this text
      </p>
    </div>
  </section>

  <style>
    /* Bidflow's band treatment on our tokens: two accent glows over the
       raised surface, so the section reads as a destination in both themes. */
    .cta-band {
      background:
        radial-gradient(
          ellipse at 50% 135%,
          color-mix(in srgb, var(--color-accent) 15%, transparent),
          transparent 62%
        ),
        radial-gradient(
          ellipse at 10% -25%,
          color-mix(in srgb, var(--color-accent-dim) 12%, transparent),
          transparent 50%
        ),
        var(--color-surface-raised);
    }
    .cta-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      margin-right: 7px;
      border-radius: 9999px;
      background: var(--color-accent);
      box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 90%, transparent);
      vertical-align: 1px;
    }
  </style>
</Base>
