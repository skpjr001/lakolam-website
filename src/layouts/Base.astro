---
// The shared shell: full SEO head (canonical, robots, Open Graph, Twitter,
// one JSON-LD @graph), theme boot script, header and footer.
//
// Every page gets three graph nodes for free — Organization, WebSite and its
// own WebPage — and may pass more via `jsonLd`; everything is emitted as a
// single @graph so the entities interlink by @id.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { organization, webPage, webSite } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  /** Absolute-from-root path of the social image, e.g. /og/default.png */
  ogImage?: string;
  ogImageAlt?: string;
  /** Extra JSON-LD graph nodes (no @context — Base wraps the graph). */
  jsonLd?: Record<string, unknown>[];
  /** The page's schema.org node type. */
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
  /** Override the robots directive — e.g. 'noindex, follow' for duplicates. */
  robots?: string;
  /** Override the derived canonical URL if a page ever needs to. */
  canonical?: string;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  ogImageAlt = `${SITE.name} — ${SITE.tagline}`,
  jsonLd = [],
  pageType = 'WebPage',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site).href;

const graph = [
  organization(),
  webSite(),
  webPage({
    type: pageType,
    url: canonical,
    title,
    description,
    image: ogImageUrl,
    hasBreadcrumb: jsonLd.some((node) => node['@type'] === 'BreadcrumbList'),
  }),
  ...jsonLd,
];
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfdfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e100f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      // Before first paint, so a dark-mode user never sees a white flash.
      // Stored choice wins over the system preference.
      (() => {
        const saved = localStorage.getItem('lakolam-theme');
        const dark =
          saved === 'dark' ||
          (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-surface text-ink flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
