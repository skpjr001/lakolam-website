// Cloudflare deployment — a Workers project serving only static assets, the
// same pattern as the two studios.
//
//   npm run build          # → dist/
//   npx wrangler deploy    # → https://lakolam-www.<account>.workers.dev
{
  "name": "lakolam-www",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "www.lakolam.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page"
  }
}
